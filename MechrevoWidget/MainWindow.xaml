<Window x:Class="MechrevoWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Mechrevo Widget"
        SizeToContent="Width" Height="30"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True" Background="Transparent"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        SourceInitialized="OnSourceInitialized">

    <Window.Resources>
        <Style x:Key="BarStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="8" Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform /></Border.RenderTransform>
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1AFFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF" />
                                <Setter TargetName="Bg" Property="RenderTransform">
                                    <Setter.Value><ScaleTransform ScaleX="0.97" ScaleY="0.97" /></Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 标签:小号灰字 -->
        <Style x:Key="Lbl" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#7FCBD5E1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,1,4,0" />
        </Style>
        <!-- 数值:等宽数字 + 固定最小宽度,温度跳动时胶囊不抖 -->
        <Style x:Key="Val" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F0FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            <Setter Property="MinWidth" Value="26" />
            <Setter Property="Text" Value="—" />
        </Style>

        <!-- ───── 右键菜单:深色圆角,与面板同一套配色 ───── -->
        <Style TargetType="ContextMenu">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Placement" Value="Top" />
            <Setter Property="VerticalOffset" Value="-4" />
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <!-- 外留 8px 给阴影 -->
                        <Border Margin="8" CornerRadius="10" Background="#F21C1F26"
                                BorderBrush="#2EFFFFFF" BorderThickness="1" Padding="4" MinWidth="168">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.45" Color="#000000" />
                            </Border.Effect>
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#E6E2E8F0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" Padding="6,6,14,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- 勾选标记:档位项显示档位色点,其它显示 ✓ -->
                                <Ellipse x:Name="Dot" Width="7" Height="7" Visibility="Collapsed"
                                         Fill="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <TextBlock x:Name="Check" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="11" Foreground="#34D399" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" VerticalAlignment="Center"
                                                  RecognizesAccessKey="True" />
                                <TextBlock Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="18,0,0,0"
                                           Foreground="#73CBD5E1" FontSize="11" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#17FFFFFF" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsCheckable" Value="False" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsChecked" Value="True" />
                                    <Condition Property="IsCheckable" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </MultiTrigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#59E2E8F0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="#1AFFFFFF" Margin="8,4" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <!-- 胶囊:半透明圆角底色,透出任务栏自带的模糊背景(不再单独叠直角 blur 层) -->
    <Border x:Name="Card" CornerRadius="9" BorderThickness="1" BorderBrush="#1FFFFFFF"
            Background="#1AFFFFFF">
        <Button x:Name="Bar" Style="{StaticResource BarStyle}" Padding="9,0,8,0" Click="OnBarClick">
            <Button.ContextMenu>
                <ContextMenu Opened="OnMenuOpened">
                    <MenuItem Header="办公" x:Name="MenuOffice" CommandParameter="office" Click="OnMenuMode" />
                    <MenuItem Header="均衡" x:Name="MenuGaming" CommandParameter="gaming" Click="OnMenuMode" />
                    <MenuItem Header="狂暴" x:Name="MenuTurbo" CommandParameter="turbo" Click="OnMenuMode" />
                    <MenuItem Header="自定义" x:Name="MenuCustom" CommandParameter="custom" Click="OnMenuMode" />
                    <Separator />
                    <MenuItem x:Name="MenuAutoStart" Header="开机自启" IsCheckable="True" Click="OnMenuAutoStart" />
                    <MenuItem Header="重新贴到任务栏" Click="OnMenuReembed" />
                    <MenuItem Header="打开日志" Click="OnMenuOpenLog" />
                    <Separator />
                    <MenuItem Header="退出" Click="OnMenuExit" />
                </ContextMenu>
            </Button.ContextMenu>
            <Button.ToolTip>
                <ToolTip x:Name="BarTip" Placement="Top" />
            </Button.ToolTip>
            <StackPanel Orientation="Horizontal">
                <!-- 档位色点(外圈光晕 + 实心点) -->
                <Grid Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,7,0">
                    <Ellipse x:Name="StatusHalo" Fill="#669CA3AF" Opacity="0.28" />
                    <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#9CA3AF" />
                </Grid>
                <TextBlock Text="CPU" Style="{StaticResource Lbl}" />
                <TextBlock x:Name="CpuTemp" Style="{StaticResource Val}" />
                <Border Width="1" Height="12" Background="#26FFFFFF" Margin="6,0,8,0" VerticalAlignment="Center" />
                <TextBlock Text="GPU" Style="{StaticResource Lbl}" />
                <TextBlock x:Name="GpuTemp" Style="{StaticResource Val}" />
            </StackPanel>
        </Button>
    </Border>
</Window>
